{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://owlsetup.owlnetgeek.fr/schema/catalog.schema.json",
  "title": "Catalogue OwlSetup",
  "type": "object",
  "required": ["applications"],
  "properties": {
    "$schema": { "type": "string" },
    "generatedFrom": { "type": "string" },
    "note": { "type": "string" },
    "count": { "type": "integer", "minimum": 0 },
    "applications": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/application" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "application": {
      "type": "object",
      "required": ["id", "name", "category", "desc", "icon", "color", "site"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
          "description": "Identifiant WinGet / MS Store. Meme regex que l'hote C# : premier caractere alphanumerique."
        },
        "name": { "type": "string", "minLength": 1 },
        "category": {
          "type": "string",
          "minLength": 1,
          "description": "Navigateurs, Utilitaires, Multimédia, Bureautique, Communication, Gaming, Développement, Composants, Sécurité, Internet, Création, Virtualisation, Intelligence artificielle."
        },
        "desc": { "type": "string", "minLength": 1 },
        "icon": { "type": "string", "minLength": 1, "maxLength": 4 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "site": { "type": "string", "pattern": "^https://" },
        "logo": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string", "enum": ["essentiel", "dev", "gaming"] }
        },
        "source": { "type": "string", "enum": ["msstore"] },
        "repairMode": { "type": "string", "enum": ["reinstall"] },
        "portable": { "type": "boolean" },
        "launchable": { "type": "boolean" },
        "manualInstall": { "type": "boolean" },
        "manualInstallUrl": { "type": "string", "pattern": "^https://" },
        "webService": { "type": "boolean" },
        "systemComponent": { "type": "boolean" }
      }
    }
  }
}
