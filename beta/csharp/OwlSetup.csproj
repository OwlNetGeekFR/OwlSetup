<?xml version="1.0" encoding="utf-8"?>
<!--
  Projet MSBuild "classique" equivalent a l'appel csc.exe code en dur dans
  ../../build.ps1. But : pouvoir ouvrir/compiler l'hote dans Visual Studio ou
  `msbuild` / `dotnet build`, obtenir IntelliSense, l'analyse Roslyn et la
  restauration NuGet automatique — sans changer le binaire produit.

  Le fichier source et les ressources restent a la RACINE du depot ; ce projet
  ne fait que les referencer via des liens.

    msbuild beta/csharp/OwlSetup.csproj /p:Configuration=Release ^
      /p:DisplayVersion=3.7.1-beta.1 /p:Channel=beta

  Etat : traduction fidele de build.ps1, a valider par un premier build cote
  mainteneur (voir PLAN-AMELIORATION.md, lot 1).
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    <AssemblyName>OwlSetup</AssemblyName>
    <RootNamespace>OwlSetup</RootNamespace>
    <ApplicationManifest>..\..\OwlSetup.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\OwlSetup.ico</ApplicationIcon>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- Surchargables en ligne de commande, comme les parametres de build.ps1. -->
    <AppVersion Condition="'$(AppVersion)' == ''">0.0.0</AppVersion>
    <Channel Condition="'$(Channel)' == ''">stable</Channel>
    <PrereleaseLabel Condition="'$(PrereleaseLabel)' == ''"></PrereleaseLabel>
    <DisplayVersion Condition="'$(DisplayVersion)' == '' and '$(Channel)' == 'stable'">$(AppVersion)</DisplayVersion>
    <DisplayVersion Condition="'$(DisplayVersion)' == '' and '$(Channel)' != 'stable'">$(AppVersion)-$(PrereleaseLabel)</DisplayVersion>
    <Version>$(AppVersion)</Version>
    <FileVersion>$(AppVersion).0</FileVersion>
    <AssemblyVersion>$(AppVersion).0</AssemblyVersion>
    <InformationalVersion>$(DisplayVersion)</InformationalVersion>
    <Company>OwlNetGeekFR</Company>
    <Product>OwlSetup</Product>
    <Description>Installation, mise a jour et entretien de Windows</Description>

    <!--
      Analyseurs Roslyn : la categorie SECURITE est traitee en erreur, le reste
      reste informatif.

      L'analyse complete (`AnalysisLevel=latest-all`) leve plus de 1 250
      avertissements sur ce fichier, dont 390 `catch` generiques et 300 appels
      sans IFormatProvider : les passer tous en erreur bloquerait le build sans
      rien apprendre d'utile aujourd'hui. Les regles de securite, elles, sont
      peu nombreuses et actionnables — elles ne doivent plus regresser.
    -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
    <WarningsAsErrors>$(WarningsAsErrors);CA5392;CA5387;CA5388;CA5389;CA5390;CA5391;CA5393;CA5394;CA5395</WarningsAsErrors>

    <!--
      Deux regles de securite sont ecartees, apres examen, et non par confort :

      CA5386 (TLS code en dur) — l'analyseur recommande SystemDefault. Sur
      .NET Framework 4.6.2, la valeur par defaut du systeme peut encore
      autoriser TLS 1.0 : forcer TLS 1.2 est ici le choix le PLUS sur. A
      reconsiderer si la cible passe en 4.7.1 ou plus.

      CA2322 (deserialisation JSON) — l'avertissement ne vaut que pour un
      JavaScriptSerializer construit avec un JavaScriptTypeResolver. Ici il est
      toujours construit sans, donc il ne peut produire que des dictionnaires,
      des tableaux et des primitives : aucun type arbitraire n'est instancie.

      Le NoWarn est volontairement au niveau du projet plutot qu'en `#pragma`
      dans le source : csc.exe, utilise par build.ps1, ne connait pas les
      identifiants d'analyseurs et signalerait chaque pragma (CS1691).
    -->
    <NoWarn>$(NoWarn);CA5386;CA2322</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\OwlSetupWebView.cs">
      <Link>OwlSetupWebView.cs</Link>
    </Compile>
    <Compile Include="$(IntermediateOutputPath)PCSetup.BuildInfo.g.cs" Condition="Exists('$(IntermediateOutputPath)PCSetup.BuildInfo.g.cs')" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\index.html"><LogicalName>index.html</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\i18n.js"><LogicalName>i18n.js</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\catalog.generated.js"><LogicalName>catalog.generated.js</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\app.js"><LogicalName>app.js</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\styles.css"><LogicalName>styles.css</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\Mettre-a-jour-mon-PC.ps1"><LogicalName>Mettre-a-jour-mon-PC.ps1</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\Liberer-espace-disque.ps1"><LogicalName>Liberer-espace-disque.ps1</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\Nettoyer-residus-applications.ps1"><LogicalName>Nettoyer-residus-applications.ps1</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\Installer-selection.ps1"><LogicalName>Installer-selection.ps1</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\branding\owlsetup-logo-512.png"><LogicalName>app-logo.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\OwlSetup.ico"><LogicalName>app-icon.ico</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\logos\*.*">
      <LogicalName>logos.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- DLL WebView2 embarquées (comme build.ps1) : l'exécutable reste
         autonome et Main() peut les extraire par leur nom logique. -->
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.Core.dll">
      <LogicalName>wv2core</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.WinForms.dll">
      <LogicalName>wv2forms</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll">
      <LogicalName>wv2loader</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Equivalent du bloc PCSetup.BuildInfo.cs genere par build.ps1. -->
  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_IsBeta Condition="'$(Channel)' != 'stable'">true</_IsBeta>
      <_IsBeta Condition="'$(Channel)' == 'stable'">false</_IsBeta>
      <_BuildInfoFile>$(IntermediateOutputPath)PCSetup.BuildInfo.g.cs</_BuildInfoFile>
    </PropertyGroup>
    <!--
      Les attributs d'assembly sont emis ICI, et non par MSBuild : le projet
      pose GenerateAssemblyInfo=false pour ne pas entrer en conflit avec ce
      fichier genere.

      Consequence longtemps passee inapercue : les proprietes Company, Product,
      Description, FileVersion et AssemblyVersion declarees plus haut etaient
      DECORATIVES. Le binaire produit par ce projet sortait en 0.0.0.0, sans
      societe — la ou build.ps1, qui genere les memes attributs a la main, les
      renseignait correctement. Le defaut n'a pas ete vu parce que ce projet ne
      servait qu'a l'analyse Roslyn, jamais a produire le binaire livre.

      La liste ci-dessous doit rester identique a celle de build.ps1 ;
      tests/Test-BuildParity.ps1 compare les deux.
    -->
    <ItemGroup>
      <_BuildInfoLines Include="using System.Reflection%3B" />
      <_BuildInfoLines Include="[assembly: AssemblyTitle(&quot;$(Product)&quot;)]" />
      <_BuildInfoLines Include="[assembly: AssemblyProduct(&quot;$(Product)&quot;)]" />
      <_BuildInfoLines Include="[assembly: AssemblyDescription(&quot;$(Description)&quot;)]" />
      <_BuildInfoLines Include="[assembly: AssemblyCompany(&quot;$(Company)&quot;)]" />
      <_BuildInfoLines Include="[assembly: AssemblyVersion(&quot;$(AssemblyVersion)&quot;)]" />
      <_BuildInfoLines Include="[assembly: AssemblyFileVersion(&quot;$(FileVersion)&quot;)]" />
      <_BuildInfoLines Include="[assembly: AssemblyInformationalVersion(&quot;$(DisplayVersion)&quot;)]" />
      <_BuildInfoLines Include="internal static class BuildInfo {" />
      <_BuildInfoLines Include="    public const string Channel = &quot;$(Channel)&quot;%3B" />
      <_BuildInfoLines Include="    public const string DisplayVersion = &quot;$(DisplayVersion)&quot;%3B" />
      <_BuildInfoLines Include="    public static readonly bool IsBeta = $(_IsBeta)%3B" />
      <_BuildInfoLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_BuildInfoFile)" Lines="@(_BuildInfoLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_BuildInfoFile)" Condition="!@(Compile->AnyHaveMetadataValue('Identity', '$(_BuildInfoFile)'))" />
    </ItemGroup>
  </Target>

</Project>
